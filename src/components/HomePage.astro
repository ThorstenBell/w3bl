---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './home/Hero.astro';
import Work from './home/Work.astro';
import Services from './home/Services.astro';
import About from './home/About.astro';
import Contact from './Contact.astro';
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
---
<BaseLayout lang={lang} path="/" title={c.meta.title} description={c.meta.description}>
  <Hero lang={lang} />
  <Work lang={lang} />
  <Services lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
