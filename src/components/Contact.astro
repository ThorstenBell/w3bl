---
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).contact;
const recaptchaSiteKey = '6Lc0ABMuAAAAAAfwYWRqV7p9r6PKNUft_XVY8--E';
---
<script is:inline async src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}></script>
<section id="contact" class="bg-primary text-primary-content">
  <div class="container-site flex flex-wrap gap-x-20 gap-y-12 py-26">
    <div class="min-w-0 flex-[1_1_380px]">
      <h2 class="heading-display text-[clamp(1.3rem,3.4vw,3rem)]">{c.title}</h2>
      <p class="mt-6 max-w-[460px] text-xl text-[#E6E9FF]">{c.text}</p>
      <p class="mt-7 text-lg"><a href="mailto:thorsten@w3bl.com" class="font-semibold text-white underline underline-offset-4">thorsten@w3bl.com</a></p>
    </div>

    <form
      class="flex min-w-0 flex-[1_1_480px] flex-col gap-[18px]"
      id="contact-form"
      name="contact-form"
      action="https://formspree.io/f/mdanwdrl"
      accept-charset="UTF-8"
      method="post"
      data-recaptcha-key={recaptchaSiteKey}
      data-sending={c.sending}
      data-success={c.success}
      data-error={c.error}
    >
      <div class="flex flex-wrap gap-[18px]">
        <label class="flex flex-[1_1_200px] flex-col gap-2 text-[15px] font-medium" for="contact-name">
          {c.name}
          <input id="contact-name" name="Name" type="text" autocomplete="name" class="input input-lg w-full rounded-xl border-0 bg-white text-ink" />
        </label>
        <label class="flex flex-[1_1_200px] flex-col gap-2 text-[15px] font-medium" for="contact-email">
          <span>{c.email} <span class="sr-only">({c.required})</span><span aria-hidden="true">*</span></span>
          <input id="contact-email" name="Email" type="email" autocomplete="email" required class="input input-lg w-full rounded-xl border-0 bg-white text-ink" />
        </label>
      </div>
      <label class="flex flex-col gap-2 text-[15px] font-medium" for="contact-message">
        <span>{c.message} <span class="sr-only">({c.required})</span><span aria-hidden="true">*</span></span>
        <textarea id="contact-message" name="Message" rows="5" required class="textarea textarea-lg w-full rounded-xl border-0 bg-white text-ink"></textarea>
      </label>
      <!-- Honeypot for Formspree spam filtering -->
      <div class="absolute -left-[5000px] h-0 w-0 overflow-hidden opacity-0" aria-hidden="true">
        <label for="contact-gotcha">Subscribe</label>
        <input name="_gotcha" value="" tabindex="-1" autocomplete="off" type="text" id="contact-gotcha" />
      </div>
      <button type="submit" class="btn btn-secondary btn-lg self-start rounded-full px-7 text-[17px] font-semibold">{c.submit}</button>
      <p id="contact-status" role="status" class="alert text-[15px] empty:hidden"></p>
    </form>
  </div>
</section>

<script>
  declare const grecaptcha: {
    ready(callback: () => void): void;
    execute(siteKey: string, options: { action: string }): Promise<string>;
  };

  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const status = document.querySelector<HTMLElement>('#contact-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const { recaptchaKey, sending, success, error } = form.dataset;

  const getRecaptchaToken = () =>
    new Promise<string>((resolve, reject) => {
      grecaptcha.ready(() => {
        grecaptcha.execute(recaptchaKey!, { action: 'submit' }).then(resolve, reject);
      });
    });

  const showStatus = (type: 'success' | 'error', message = '') => {
    status.classList.toggle('alert-success', type === 'success');
    status.classList.toggle('alert-error', type === 'error');
    status.textContent = message;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const label = button.textContent;
    button.disabled = true;
    button.textContent = sending!;
    status.textContent = '';

    try {
      const data = new FormData(form);
      data.set('g-recaptcha-response', await getRecaptchaToken());
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Formspree responded with ${response.status}`);
      form.reset();
      showStatus('success', success);
    } catch (err) {
      console.error(err);
      showStatus('error', error);
    } finally {
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>
