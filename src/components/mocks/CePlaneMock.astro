---
interface Props {
  label: string;
}
const { label } = Astro.props;

// Deterministic point cloud so the build output is stable.
let seed = 7;
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const points = Array.from({ length: 60 }, () => {
  const g = (rand() + rand() + rand()) / 3;
  const h = (rand() + rand() + rand()) / 3;
  return { x: Math.round(150 + (g - 0.38) * 260), y: Math.round(90 - (h - 0.42) * 220) };
});
---
<div class="rounded-2xl bg-panel p-4 text-ink" aria-hidden="true">
  <p class="mb-1.5 text-[13px] font-semibold">{label}</p>
  <svg viewBox="0 0 300 180" class="block h-auto w-full">
    <line x1="150" y1="6" x2="150" y2="174" stroke="#9AA3B8" stroke-width="1" />
    <line x1="6" y1="90" x2="294" y2="90" stroke="#9AA3B8" stroke-width="1" />
    <line x1="20" y1="170" x2="290" y2="12" stroke="#E0702E" stroke-width="1.5" stroke-dasharray="5 4" />
    {points.map((p) => <circle cx={p.x} cy={p.y} r="2.4" fill="#2234C9" fill-opacity="0.55" />)}
  </svg>
</div>
