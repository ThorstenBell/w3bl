---
import Logo from './Logo.astro';
import { type Lang, localePath, t } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const c = t(lang).nav;
const home = localePath(lang, '/');
const otherLang: Lang = lang === 'en' ? 'nl' : 'en';
const links = [
  { href: `${home}#work`, label: c.work },
  { href: `${home}#services`, label: c.services },
  { href: `${home}#about`, label: c.about },
];
---
<header class="sticky top-0 z-50 border-b border-line bg-base-100/95 backdrop-blur">
  <nav aria-label={c.label} class="navbar container-site min-h-0 flex-wrap gap-4 py-4">
    <a href={home} aria-label={c.home} class="flex items-center">
      <Logo />
    </a>
    <div class="ml-auto flex flex-wrap items-center gap-x-7 gap-y-2 text-base font-medium">
      {links.map((l) => (
        <a href={l.href} class="hidden text-ink no-underline hover:text-primary sm:inline">{l.label}</a>
      ))}
      <a
        href={localePath(otherLang, path)}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={c.switchLabel}
        class="text-muted no-underline hover:text-primary"
      >{c.switchShort}</a>
      <a href={`${home}#contact`} class="btn btn-secondary rounded-full px-5 text-base font-medium">{c.cta}</a>
    </div>
  </nav>
</header>
