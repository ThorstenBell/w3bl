---
import { type Lang, t } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
---
<section id="services" class="container-site pt-28 pb-10">
  <h2 class="heading-display mb-12 text-[clamp(1.4rem,3.2vw,2.75rem)]">{c.services.title}</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,520px),1fr))] gap-x-16">
    {c.services.items.map((s) => (
      <div class="border-t-[1.5px] border-ink pt-7 pb-12">
        <h3 class="text-[28px] font-semibold leading-tight">{s.title}</h3>
        <p class="mt-3 max-w-[520px] text-body">{s.text}</p>
        <p class="mt-4 text-base text-muted">{s.tags}</p>
      </div>
    ))}
  </div>
</section>

<section aria-labelledby="why-title" class="container-site pt-14 pb-26">
  <div class="flex flex-wrap gap-x-18 gap-y-10 rounded-[32px] bg-base-200 p-[clamp(1.75rem,5vw,4rem)]">
    <h2 id="why-title" class="flex-[1_1_320px] text-[clamp(1.875rem,3.4vw,2.875rem)] font-semibold leading-[1.12] tracking-[-0.01em]">{c.why.title}</h2>
    <div class="grid flex-[2_1_520px] grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-8">
      {c.why.items.map((item) => (
        <div>
          <h3 class="text-xl font-semibold">{item.title}</h3>
          <p class="mt-2 text-[17px] text-body">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section aria-labelledby="projects-title" class="container-site flex flex-wrap gap-x-18 gap-y-8 pb-26">
  <h2 id="projects-title" class="flex-[1_1_320px] text-3xl font-semibold leading-tight">{c.projects.title}</h2>
  <ul class="grid flex-[2_1_520px] grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-x-10">
    {c.projects.items.map((item) => <li class="border-b border-line py-3.5">{item}</li>)}
  </ul>
</section>
