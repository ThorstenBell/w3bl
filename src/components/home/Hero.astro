---
import { type Lang, t } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
---
<section class="container-site pt-16 pb-14 md:pt-22 md:pb-18">
  <p class="mb-7 flex items-center gap-2.5 text-base text-body">
    <span aria-hidden="true" class="size-2.5 rounded-full bg-success shadow-[0_0_0_4px_#CFEBDA]"></span>
    {c.hero.status}
  </p>
  <h1 class="heading-display text-[clamp(1.05rem,4.6vw,4.2rem)] leading-[1.08] tracking-[0.005em] text-ink">
    {c.hero.titleLines.map((line) => <>{line}<br /></>)}
    <span class="text-primary">{c.hero.titleAccent}</span>
  </h1>
  <div class="mt-12 flex flex-wrap items-end justify-between gap-x-16 gap-y-8">
    <p class="max-w-[620px] text-[21px] leading-normal text-body">{c.hero.intro}</p>
    <div class="flex flex-wrap gap-3">
      <a href="#contact" class="btn btn-primary btn-lg rounded-full px-7 text-[17px] font-semibold">{c.hero.primary}</a>
      <a href="#work" class="btn btn-outline btn-lg rounded-full border-[1.5px] border-ink px-7 text-[17px] font-semibold text-ink hover:bg-ink hover:text-white">{c.hero.secondary}</a>
    </div>
  </div>
</section>

<section aria-label={c.credentials.label} class="container-site pb-24">
  <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] border-t-[1.5px] border-ink">
    {c.credentials.items.map((item) => (
      <li class="pt-5 pr-6">
        <p class="text-[28px] font-semibold leading-tight">{item.value}</p>
        <p class="mt-1 text-base text-muted">{item.text}</p>
      </li>
    ))}
  </ul>
</section>
