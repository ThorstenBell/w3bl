---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentMock from './mocks/AgentMock.astro';
import { type Lang, localePath, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).caseAgent;
const home = localePath(lang, '/');
---
<BaseLayout lang={lang} path="/work/hecoagent/" title={c.metaTitle} description={c.metaDescription}>
  <article>
    <header class="container-site pt-16 pb-14">
      <a href={`${home}#work`} class="text-base font-medium text-body hover:text-primary">{c.back}</a>
      <h1 class="heading-display mt-9 text-[clamp(1.6rem,6vw,5.5rem)] leading-[1.02]">HecoAgent</h1>
      <p class="mt-6 max-w-[760px] text-[clamp(1.3rem,2vw,1.625rem)] leading-snug text-body">{c.intro}</p>
      <dl class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] border-t-[1.5px] border-ink">
        {c.facts.map((f) => (
          <div class="pt-4.5 pr-6">
            <dt class="text-[15px] text-muted">{f.label}</dt>
            <dd class="mt-1 font-semibold">{f.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <section aria-label="HecoAgent" class="container-site pb-24">
      <div class="rounded-[32px] bg-ink p-[clamp(1.25rem,4vw,3.5rem)]">
        <div role="img" aria-label={c.screenLabel}>
          <AgentMock lang={lang} variant="full" />
        </div>
      </div>
      <p class="mt-3.5 text-[15px] text-muted">{c.screenNote}</p>
    </section>

    <section class="container-site flex flex-col gap-16 pb-10">
      <div class="flex flex-wrap gap-x-18 gap-y-4">
        <h2 class="flex-[1_1_260px] text-3xl font-semibold leading-tight">{c.challengeTitle}</h2>
        <div class="max-w-[720px] flex-[2_1_520px] text-xl text-body">
          {c.challenge.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="flex flex-wrap gap-x-18 gap-y-4">
        <h2 class="flex-[1_1_260px] text-3xl font-semibold leading-tight">{c.builtTitle}</h2>
        <div class="flex max-w-[720px] flex-[2_1_520px] flex-col gap-4 text-xl text-body">
          {c.built.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section aria-labelledby="flow-title" class="container-site pt-10 pb-24">
      <h2 id="flow-title" class="mb-8 text-3xl font-semibold">{c.flowTitle}</h2>
      <ol class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-4">
        {c.flow.map((step) => (
          <li class="rounded-[20px] border-t-4 border-primary bg-base-200 p-6">
            <p class="text-[15px] text-muted">{step.where}</p>
            <p class="mt-1.5 text-xl font-semibold">{step.title}</p>
            <p class="mt-2 text-base text-body">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container-site pb-28">
      <div class="flex flex-wrap gap-x-18 gap-y-4 rounded-[32px] bg-base-200 p-[clamp(1.75rem,5vw,4rem)]">
        <h2 class="flex-[1_1_260px] text-3xl font-semibold leading-tight">{c.resultTitle}</h2>
        <div class="max-w-[720px] flex-[2_1_520px] text-xl text-body">
          {c.result.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <nav aria-label={c.next} class="border-t border-line">
      <div class="container-site flex flex-wrap items-center justify-between gap-6 py-14">
        <a href={`${home}#work`} class="text-lg font-semibold text-ink">{c.allWork}</a>
        <a href={`${home}#work`} class="text-right text-ink no-underline hover:text-primary">
          <span class="block text-[15px] text-muted">{c.next}</span>
          <span class="font-display text-[clamp(1.25rem,3vw,2.5rem)]">{c.nextTitle}</span>
        </a>
      </div>
    </nav>
  </article>

  <section class="bg-primary text-primary-content">
    <div class="container-site flex flex-wrap items-center justify-between gap-8 py-22">
      <div class="max-w-[640px]">
        <h2 class="heading-display text-[clamp(1.25rem,3vw,2.5rem)]">{c.ctaTitle}</h2>
        <p class="mt-4.5 text-xl text-[#E6E9FF]">{c.ctaText}</p>
      </div>
      <a href={`${home}#contact`} class="btn btn-lg rounded-full border-0 bg-white px-7 font-semibold text-ink hover:bg-base-100">{c.ctaButton}</a>
    </div>
  </section>
</BaseLayout>
