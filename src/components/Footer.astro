---
import Logo from './Logo.astro';
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const year = new Date().getFullYear();
---
<footer class="bg-ink text-on-ink-muted">
  <div class="container-site flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-8 text-[15px]">
    <div class="flex items-center gap-4">
      <Logo class="h-4 w-auto fill-on-ink" />
      <span>© {year} W3BL, Thorsten Bell</span>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <a href="https://www.malt.com/profile/thorstenbell" class="text-on-ink hover:text-white">Malt</a>
      <a href="https://www.linkedin.com/company/w3bl" class="text-on-ink hover:text-white">LinkedIn</a>
      <a href="https://github.com/ThorstenBell" class="text-on-ink hover:text-white">GitHub</a>
    </div>
    <span>KvK 98605003, {c.footer.btw} NL005342447B77</span>
  </div>
</footer>
