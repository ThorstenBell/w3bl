---
import type {SanityDocument} from "@sanity/client";
import {sanityClient} from "sanity:client";
import {createImageUrlBuilder, type SanityImageSource} from "@sanity/image-url";
import {PortableText} from "astro-portabletext";
import {$t} from "../../../utils/i18n";
import PostLayout from "../../../layouts/PostLayout.astro";

const {lang, slug} = Astro.params;

const POST_QUERY = `*[_type == "post" && slug.current == $slug][0]`;
const post = await sanityClient.fetch<SanityDocument>(POST_QUERY, {slug});

export async function getStaticPaths() {
    // Fetch all posts with their language and slug
    const SLUGS_QUERY = `*[_type == "post" && defined(slug.current)]{
        "slug": slug.current,
        "lang": language
    }`;

    const posts = await sanityClient.fetch(SLUGS_QUERY);

    return posts.map((post: { slug: string, lang: string, translations: object }) => ({
        params: {
            lang: post.lang,
            slug: post.slug
        }
    }));
}

const {projectId, dataset} = sanityClient.config();
const urlFor = (source: SanityImageSource) =>
    projectId && dataset
        ? createImageUrlBuilder({projectId, dataset}).image(source)
        : null;
const postImageUrl = post.image
    ? urlFor(post.image)?.width(550).height(310).url()
    : null;

const pageTitle = $t("SEO-Friendly Web Developer & Graphic Designer | Fast, Responsive Websites", lang);
const pageDescription = $t("I'm a web developer and graphic designer based in the Netherlands. I specialize in creating fast, responsive websites and web applications.", lang);
---

<PostLayout pageTitle={pageTitle} pageDescription={pageDescription}>
    <section class="py-8 px-4 mx-auto max-w-7xl lg:py-16">
        <a href={`/${lang}/posts`} class="hover:underline">&larr; Back to posts</a>
        {
            postImageUrl && (
                        <img
                                src={postImageUrl}
                                alt={post.title}
                                class="aspect-video rounded-xl"
                                width="550"
                                height="310"
                        />
            )
        }
        <h1 class="text-4xl font-bold mb-8">{post.title}</h1>
        <div class="prose">
            <p>Published: {new Date(post.publishedAt).toLocaleDateString()}</p>
            {Array.isArray(post.body) &&
                    <PortableText value={post.body}/>}
        </div>
    </section>
</PostLayout>