---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import {getPageBySlug} from '../lib/pages';

const page = await getPageBySlug('home');

const pageTitle = page?.title ?? 'Thorsten Bell | Freelance Web Developer & Graphic Designer';
const pageDescription =
  "I'm a web developer and graphic designer based in the Netherlands. I specialize in creating fast, responsive websites and web applications.";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <BlockRenderer blocks={page?.blocks} />
</BaseLayout>
